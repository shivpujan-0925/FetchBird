PORT=5000
MONGO_URI=mongodb://localhost:27017/fetchbird
CLIENT_ORIGIN=http://localhost:5173
TEMP_DIR=./tmp
FILE_TTL_MINUTES=60
MAX_CONCURRENT_DOWNLOADS=2
MAX_VIDEO_DURATION_SECONDS=21600

# ==========================================
# YouTube Anti-Bot & Cookies Configuration
# ==========================================
# (Required when running on cloud hosts like Render / AWS to bypass "Sign in to confirm you're not a bot")
# Option 1: Direct file path to cookies.txt (e.g. Render Secret File mounted at /etc/secrets/cookies.txt)
# COOKIES_PATH=/etc/secrets/cookies.txt

# Option 2: Raw Netscape cookie content or base64-encoded cookie string in env var
# YOUTUBE_COOKIES=

# Optional: HTTP/HTTPS or SOCKS5 proxy URL
# PROXY_URL=

# Optional: Custom yt-dlp extractor arguments (defaults to youtube:player_client=ios,web,mweb)
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=ios,web,mweb
